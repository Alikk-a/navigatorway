# Host port for nginx (container still listens on 80). Access via Tailscale or Cloudflare Tunnel.
NGINX_PUBLISH_PORT=8088

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Tailscale IP of the server, later add navigatorway.com when DNS points here.
DJANGO_ALLOWED_HOSTS=100.114.128.98,127.0.0.1,localhost,navigatorway.com,www.navigatorway.com
DJANGO_BEHIND_PROXY=1
CSRF_TRUSTED_ORIGINS=http://100.114.128.98:8088,http://127.0.0.1:8088,https://navigatorway.com,https://www.navigatorway.com

POSTGRES_DB=navigatorway
POSTGRES_USER=navigator
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
