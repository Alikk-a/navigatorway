DJANGO_SECRET_KEY=change-me-local-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Your existing WSL PostgreSQL (service postgresql)
POSTGRES_DB=navigatorway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: MariaDB in Docker only to load navigator_dump.sql, then import_legacy_mysql
MYSQL_LEGACY_HOST=127.0.0.1
MYSQL_LEGACY_PORT=3307
MYSQL_LEGACY_DB=navigator_21
MYSQL_LEGACY_USER=root
MYSQL_LEGACY_PASSWORD=root
